# Plantilla de configuración. Copia este archivo a .env (que NO se sube a Git) y cambia
# todos los valores CAMBIAME. En PowerShell:  Copy-Item .env.example .env
# Ningún valor de este archivo es real.

# --- PostgreSQL de desarrollo (lo usa docker-compose.yml) ---
POSTGRES_PASSWORD=CAMBIAME-contrasena-postgres-dev

# --- Backend (pydantic-settings, prefijo PORTERO_) ---
# Desde Windows (uv run) la BD está en localhost:5434 (el 5432 suele ocuparlo un PostgreSQL
# instalado en Windows); dentro de Compose se sobrescribe con host "db" y puerto 5432.
PORTERO_DATABASE_URL=postgresql+asyncpg://portero:CAMBIAME-contrasena-postgres-dev@localhost:5434/portero

# Passphrase de la que se deriva la KEK con Argon2id (Cap. 6, spec §1.6). Usa una frase larga.
PORTERO_KEK_PASSPHRASE=CAMBIAME-passphrase-larga-de-la-kek

# Clave privada Ed25519 en PEM para firmar JWT (spec §3.2). Genérala desde backend/ con
#   uv run python scripts/generate_jwt_key.py
# y reemplaza esta línea por la que imprime (una sola línea con \n escapados).
PORTERO_JWT_PRIVATE_KEY="CAMBIAME-pegar-aqui-la-clave-PEM-Ed25519"

# Firma diaria del cierre de la bitácora (H-81). Opcional. Genera el par desde backend/ con
#   uv run python scripts/generate_oplog_key.py
# Aquí va SOLO la llave pública: la API la usa para verificar las firmas.
# PORTERO_OPLOG_SIGNING_PUBLIC_KEY="CAMBIAME-pegar-aqui-la-clave-publica-PEM-Ed25519"
# La privada (PORTERO_OPLOG_SIGNING_PRIVATE_KEY) NUNCA va en este archivo: docker-compose.yml
# carga todo el .env en el contenedor de la API. Se le pasa solo a la tarea programada que corre
# "python -m portero.cli sign-chain" (guía de instalación).

# Emisor de los JWT (claim iss): URL canónica de la instalación (Cap. 6). Obligatoria.
PORTERO_JWT_ISSUER=http://localhost:8000

# Orígenes permitidos por CORS (lista JSON). El frontend de Vite corre en el 5173.
# No se admiten "*" ni "null": CORS lleva credenciales por la cookie del refresh token (H-29).
PORTERO_ALLOWED_ORIGINS=["http://localhost:5173"]

# Expone /docs y /openapi.json. En producción debe ser false.
PORTERO_DOCS_ENABLED=true

# Límite por minuto y por IP de /auth/login y /auth/refresh (Cap. 6: 10). Solo el stack E2E lo
# sube (H-56); en desarrollo y producción déjalo comentado.
# PORTERO_RATE_LIMIT_AUTH_PER_MINUTE=10

# Nivel de los logs JSON del backend: DEBUG, INFO, WARNING o ERROR (H-70). Con WARNING o más
# no sale el log de acceso.
PORTERO_LOG_LEVEL=INFO

# --- Dashboard (nginx del contenedor frontend) ---
# H-79: IP o CIDR del proxy con TLS que va delante del 8080, separadas por comas (guía de
# instalación §6.3). Solo de esas IP se cree el X-Forwarded-For, para que el límite de login por
# IP y la bitácora vean la IP real del usuario. Vacía: se ignora todo X-Forwarded-For (como
# siempre). Con un proxy en el mismo servidor Linux suele ser la puerta de enlace de la red de
# Compose; un valor inválido impide que el contenedor arranque.
# PORTERO_TRUSTED_PROXY=172.30.250.1
